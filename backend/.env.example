# -----------------------------------------------------------------------------
# INBOUNDSHIELD AI — Environment Configuration Example
# -----------------------------------------------------------------------------

# Primary Database (MySQL 8+ required for production enterprise deployments)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Leave blank to use zero-dependency local SQLite database: sqlite:///./inboundshield.db
DATABASE_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=inboundshield
MYSQL_USER=
MYSQL_PASSWORD=

# Application Environment
APP_ENV=development
SECRET_KEY=inboundshield_production_secret_key_change_me_2026

# Storage Provider Configuration (Section 7)
# Options: "local" (default filesystem) or "data_uri" (serverless deployment / Vercel fallback)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
FIXTURES_DIR=fixtures

# Vision AI Provider Configuration (Section 11)
# Options: "hybrid", "gemini", or "local_cv"
VISION_PROVIDER=hybrid
GEMINI_API_KEY=
